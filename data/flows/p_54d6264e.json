   "caption_zh": "十月的伊斯坦堡",
   "caption_en": ""
  },
  {
   "type": "stanza",
   "zh": [
    "藍得像土耳其藍"
   ],
   "en": [
    "Blue as Turkish blue"
   ]
  },
  {
   "type": "stanza",
   "zh": [
    "Anatolia 浩瀚無際的天空",
    "藍得像土耳其藍",
    "Bosporus 海峽的粼粼波紋",
    "藍得像土耳其藍",
    "Topkapi 皇宮的花彫瓷壁",
    "藍得像土耳其藍",
    "Blue Mosque 的圓穹環柱",
    "藍得像土耳其藍",
    "Grand Bazaar 的地氈圖案",
    "藍得像土耳其藍"
   ],
   "en": [
    "Anatolia's vast, boundless sky",
    "Blue as Turkish blue",
    "The Bosporus strait's shimmering ripples",
    "Blue as Turkish blue",
    "The carved floral porcelain walls of Topkapi Palace",
    "Blue as Turkish blue",
    "The Blue Mosque's domed rotunda and columns",
    "Blue as Turkish blue",
    "The Grand Bazaar's carpet patterns",
    "Blue as Turkish blue"
   ]
  },
  {
   "type": "stanza",
   "zh": [
    "超越色調也超越光譜",
    "土耳其藍",
    "是",
    "斑駁歲月的藍",
    "還樸歸真的藍",
    "掩卷沉思的藍",
    "乘風欲去的藍",
    "塵埃落定的藍",
    "緣起緣滅的藍"
   ],
   "en": [
    "Transcending tone, transcending spectrum too",
    "Turkish blue",
    "Is",
    "The mottled blue of passing years",
    "A blue returned to simplicity and truth",
    "Blue, closing the book to ponder",
    "A blue that longs to ride the wind and go",
    "A blue where the dust has settled",
    "The blue of causes arising and fading"
   ]
  },
  {
   "type": "stanza",
   "zh": [
    "是印象也是想像",
    "土耳其藍",
    "是",
    "一種懷古",
    "一種輝煌",
    "一種視野",
    "一種心境",
    "一種祈願",
    "一種寧靜"
   ],
   "en": [
    "It is impression, and also imagination",
    "Turkish blue",
    "Is",
    "A kind of nostalgia for the past",
    "A kind of splendor",
    "A kind of vision",
    "A state of mind",
    "A kind of prayer",
    "A kind of stillness"
   ]
  },
  {
   "type": "stanza",
   "zh": [
    "十月的伊斯坦堡",
    "藍得像土耳其藍",
    "藍得",
    "高處不勝寒"
   ],
   "en": [
    "Istanbul in October",
    "Blue as Turkish blue",
    "So blue",
    "At such heights, the cold is unbearable"
   ]
  }
 ],
