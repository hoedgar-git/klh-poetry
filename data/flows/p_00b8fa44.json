 "title": "浮升的意象",
 "source": "浮升的意象.docx",
 "flow": [
  {
   "type": "title",
   "zh": "浮升的意象"
  },
  {
   "type": "byline",
   "zh": "何康隆"
  },
  {
   "type": "image",
   "src": "images/flow/p_00b8fa44/img1.jpg",
   "caption_zh": "如果人生是一趟旅途",
   "caption_en": ""
  },
  {
   "type": "stanza",
   "zh": [
    "那麼我們",
    "如何省視那段披塵沾露的心情",
    "如何揣摩下個驛站里程的願景"
   ],
   "en": []
  },
  {
   "type": "stanza",
   "zh": [
    "如果生命是持續提升的傳承",
    "那麼我們",
    "如何啟發質良意美的流風意向",
    "如何串聯點線面激成一番氣象"
   ],
   "en": []
  },
  {
   "type": "stanza",
   "zh": [
    "如果生活是不斷的塑造和組合",
    "那麼我們",
    "如何在這些層面 :"
   ],
   "en": []
  },
  {
   "type": "stanza",
   "zh": [
    "人文的關注",
    "科學的探索",
    "藝術的追尋",
    "宗教的情懷",
    "道德的實踐"
   ],
   "en": []
  },
  {
   "type": "stanza",
   "zh": [
    "摺疊出一幅賞心悅目的意象"
   ],
   "en": []
  }
 ]
}